            "Resource": [
                "arn:aws:logs:ap-northeast-2:842337469411:log-group:/aws/lambda/patch_agent:*"
            ]
        },
        {
            "Sid": "AllowInvokeAgentCore",
            "Effect": "Allow",
            "Action": "bedrock-agentcore:InvokeAgentRuntime",
            "Resource": [
                "arn:aws:bedrock-agentcore:ap-northeast-2:842337469411:runtime/patch_exec_agent-gX4MoR2Lnj*",
                "arn:aws:bedrock-agentcore:ap-northeast-2:842337469411:runtime/patch_impact_container-xZZJBa7PNA*"
            ]
        }
    ]
}
