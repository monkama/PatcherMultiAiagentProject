==================================================
Policy ARN: arn:aws:iam::<AWS_ACCOUNT_ID>:policy/<POLICY_NAME>
==================================================
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "Ec2ForLabStack",
            "Effect": "Allow",
            "Action": "ec2:*",
            "Resource": "*"
        },
        {
            "Sid": "ReadPublicAmiFromSsm",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters"
            ],
            "Resource": "*"
        },
        {
            "Sid": "iam",
            "Effect": "Allow",
            "Action": [
                "iam:*"
            ],
            "Resource": "*"
        }
    ]
}
